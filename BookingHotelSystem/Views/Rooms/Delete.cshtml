@model BookingHotelSystem.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container mt-4">
    <h3 class="text-danger">Are you sure you want to delete this room?</h3>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Room Number</dt>
        <dd class="col-sm-9">@Model.RoomNumber</dd>

        <dt class="col-sm-3">Room Type</dt>
        <dd class="col-sm-9">@Model.RoomType</dd>

        <dt class="col-sm-3">Price (RM)</dt>
        <dd class="col-sm-9">RM @Model.Price.ToString("N2")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>