@model BookingHotelSystem.Models.Booking

@{
    ViewData["Title"] = "Cancel Booking";
}

<div class="container mt-4">
    <h3 class="text-danger">Are you sure you want to cancel this booking?</h3>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.User?.Name</dd>

        <dt class="col-sm-3">Room</dt>
        <dd class="col-sm-9">@Model.Room?.RoomNumber</dd>

        <dt class="col-sm-3">Payment Status</dt>
        <dd class="col-sm-9">@Model.PaymentStatus</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirm Cancellation</button> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>