@model BookingHotelSystem.Models.Booking

@{
    ViewData["Title"] = "Booking Room";
}

<div class="container mt-4">
    <h2>Book a Room</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div class="mb-3">
                    <label asp-for="UserId" class="form-label">Select User</label>
                    <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="RoomId" class="form-label">Select Available Room</label>
                    <select asp-for="RoomId" class="form-select" asp-items="ViewBag.RoomId"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="CheckInDate" class="form-label">Check-In Date</label>
                    <input asp-for="CheckInDate" class="form-control" type="date" />
                </div>
                <div class="mb-3">
                    <label asp-for="CheckOutDate" class="form-label">Check-Out Date</label>
                    <input asp-for="CheckOutDate" class="form-control" type="date" />
                </div>
                <button type="submit" class="btn btn-success">Proceed to Payment</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>