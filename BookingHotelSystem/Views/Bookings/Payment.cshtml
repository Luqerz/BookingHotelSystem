@model BookingHotelSystem.Models.Booking

@{
    ViewData["Title"] = "Process Payment";
}

<div class="container mt-4">
    <h2>Process Payment</h2>
    <hr />
    <div class="card p-4 col-md-6">
        <h4>Booking Summary</h4>
        <p><strong>Customer:</strong> @Model.User?.Name</p>
        <p><strong>Room:</strong> @Model.Room?.RoomNumber (@Model.Room?.RoomType)</p>
        <p><strong>Price per Night:</strong> RM @Model.Room?.Price.ToString("N2")</p>
        <p><strong>Status:</strong> <span class="badge bg-warning">@Model.PaymentStatus</span></p>

        <form asp-action="ProcessPayment" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-primary w-100">Pay Now (Simulate Payment)</button>
        </form>
    </div>
</div>